if(NOT EXISTS "${PGM}")
    message(FATAL_ERROR "terrain preview output is missing: ${PGM}")
endif()
file(SIZE "${PGM}" size)
if(NOT size EQUAL 205)
    message(FATAL_ERROR "terrain preview size ${size} != 205 (13-byte header + 16*12 pixels)")
endif()
file(READ "${PGM}" header LIMIT 13 HEX)
if(NOT header STREQUAL "50350a31362031320a3235350a")
    message(FATAL_ERROR "unexpected PGM header: ${header}")
endif()
